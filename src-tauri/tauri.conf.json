{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TeamHub HRMS",
  "version": "1.0.0",
  "identifier": "com.flareminds.hrms",

  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TeamHub HRMS",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],

    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "publisher": "FlareMindsTech",
    "copyright": "Copyright \u00a9 2026 FlareMindsTech",
    "shortDescription": "TeamHub HRMS desktop application",
    "longDescription": "TeamHub HRMS - Human Resource Management System by FlareMindsTech.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
